# Copy to .env in the repository. Keep credentials and local settings out of Git.
# Shell variables override .env; .env overrides configs/default.yaml.

# Local recording folder. Relative paths start at the repository.
#PAI_OUTPUT_ROOT=output

# SSH access from the Windows recording account to Gamma.
# Install with: python -m pip install -e '.[remote]'
#PAI_GAMMA_HOST=
#PAI_GAMMA_USER=
#PAI_GAMMA_KEY_PATH=
#PAI_GAMMA_PASSWORD=

# Globus Connect Personal collection on THIS recording PC.
PAI_GLOBUS_LOCAL_ENDPOINT_ID=

# FASRC destination collection and path must refer to the same storage system.
# Confirm the lab's current location before overriding the existing defaults.
#PAI_GLOBUS_REMOTE_ENDPOINT_ID=
#PAI_ARCHIVE_ROOT=/n/holylabs/lexie_lab/Lab/gpu_power_logs
